<section id="plan" class="relative overflow-hidden border-t border-gold/20">
  <img
    src="/images/bagan-sunset.jpg"
    alt=""
    width="2000"
    height="1333"
    loading="lazy"
    aria-hidden="true"
    class="absolute inset-0 size-full object-cover"
  />
  <div class="absolute inset-0 bg-lacquer/85"></div>

  <div class="relative mx-auto max-w-7xl px-5 py-24 sm:px-8 lg:py-32">
    <p
      data-reveal
      class="font-mono text-xs tracking-[0.24em] text-gold uppercase"
    >
      Begin
    </p>
    <h2
      data-reveal
      style="--reveal-delay: 90ms"
      class="mt-6 max-w-3xl font-display text-4xl leading-[1.08] tracking-wide text-bone text-balance sm:text-6xl"
    >
      Start with a conversation,
      <span class="text-gold">not a brochure.</span>
    </h2>
    <p
      data-reveal
      style="--reveal-delay: 160ms"
      class="mt-6 max-w-xl text-sm leading-relaxed text-bone/80 sm:text-base"
    >
      Tell us roughly when you'd like to come and what you refuse to skip.
      Within one working day you'll hear from Khin Myo or Zaw — with a draft
      route, honest seasonal advice, and a price that doesn't move after you
      land.
    </p>

    <form
      data-reveal
      style="--reveal-delay: 230ms"
      class="mt-10 grid max-w-2xl gap-4 sm:grid-cols-[1fr_1fr_auto]"
      action="mailto:hello@thiritravel.co.mm"
      method="post"
      enctype="text/plain"
      autocomplete="off"
    >
      <label class="sr-only" for="plan-name">Your name</label>
      <input
        id="plan-name"
        name="name"
        type="text"
        required
        autocomplete="name"
        placeholder="Your name…"
        class="min-h-12 border border-bone/25 bg-lacquer/70 px-5 py-4 font-mono text-sm text-bone placeholder:text-bone/45 focus:border-gold focus:outline-none"
      />
      <label class="sr-only" for="plan-email">Email address</label>
      <input
        id="plan-email"
        name="email"
        type="email"
        inputmode="email"
        required
        autocomplete="email"
        spellcheck="false"
        placeholder="you@example.com…"
        class="min-h-12 border border-bone/25 bg-lacquer/70 px-5 py-4 font-mono text-sm text-bone placeholder:text-bone/45 focus:border-gold focus:outline-none"
      />
      <button
        type="submit"
        class="min-h-12 border border-gold bg-gold px-7 py-4 font-mono text-xs tracking-[0.16em] text-lacquer uppercase transition-colors hover:bg-gold-soft hover:border-gold-soft"
      >
        Plan my journey
      </button>
    </form>

    <p
      data-reveal
      class="tnum mt-6 font-mono text-[11px] tracking-[0.16em] text-bone/60 uppercase"
    >
      Or write directly — hello@thiritravel.co.mm · +95&nbsp;9&nbsp;770&nbsp;114&nbsp;253
    </p>
  </div>
</section>
