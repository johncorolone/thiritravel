---
const facts = [
  "Founded in 2009 by Daw Khin Myo Chit and her brother Ko Aung, with one van and a secondhand telephone.",
  "Twelve full-time staff and nine licensed guides — the same faces every season, no rotating freelancers.",
  "Member of the Union of Myanmar Travel Association (UMTA) since 2011.",
];
---

<section class="bg-lacquer">
  <div class="mx-auto max-w-7xl px-5 py-24 sm:px-8 lg:py-32">
    <p
      data-reveal
      class="font-mono text-xs tracking-[0.24em] text-gold uppercase"
    >
      Who we are
    </p>

    <div class="mt-8 grid gap-14 lg:grid-cols-12">
      <h2
        data-reveal
        style="--reveal-delay: 80ms"
        class="font-display text-3xl leading-snug tracking-wide text-bone text-balance sm:text-4xl lg:col-span-7"
      >
        We don't sell packages. We plan journeys the way we'd plan them for
        our own cousins visiting from Singapore —
        <span class="text-gold">honest advice, patient drivers, and time to
        sit still.</span>
      </h2>

      <div data-reveal style="--reveal-delay: 160ms" class="lg:col-span-4 lg:col-start-9">
        <div class="border border-gold/30 bg-panel p-6">
          <p class="font-myanmar text-xl text-gold">မင်္ဂလာပါ</p>
          <p class="mt-1 font-mono text-[10px] tracking-[0.2em] text-bone/60 uppercase">
            Mingalaba — a warm welcome
          </p>
        </div>
        <ul class="mt-8 space-y-5 border-t border-bone/15 pt-8">
          {
            facts.map((fact) => (
              <li class="flex gap-4 text-sm leading-relaxed text-bone/75">
                <span class="mt-1.5 size-1.5 shrink-0 rotate-45 bg-gold" aria-hidden="true" />
                {fact}
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="mt-16 grid gap-6 sm:grid-cols-2">
      <figure data-reveal>
        <img
          src="/images/ox-cart.jpg"
          alt="A family riding an ox-cart along a dusty track through dry fields"
          width="640"
          height="427"
          loading="lazy"
          class="aspect-[3/2] w-full border border-gold/20 object-cover"
        />
        <figcaption
          class="mt-3 flex items-center justify-between font-mono text-[10px] tracking-[0.18em] text-bone/50 uppercase"
        >
          <span>On the Yangon–Mandalay road</span>
          <span>N&nbsp;21°10′ E&nbsp;94°51′</span>
        </figcaption>
      </figure>
      <figure data-reveal style="--reveal-delay: 120ms">
        <img
          src="/images/shan-child.jpg"
          alt="A smiling child in a woollen hat in a highland village lane"
          width="640"
          height="427"
          loading="lazy"
          class="aspect-[3/2] w-full border border-gold/20 object-cover"
        />
        <figcaption
          class="mt-3 flex items-center justify-between font-mono text-[10px] tracking-[0.18em] text-bone/50 uppercase"
        >
          <span>Shan hills, February morning</span>
          <span>N&nbsp;20°47′ E&nbsp;96°29′</span>
        </figcaption>
      </figure>
    </div>
  </div>
</section>
