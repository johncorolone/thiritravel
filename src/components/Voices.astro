---
const voices = [
  {
    quote:
      "Fourteen days and not one moment felt scripted. Our guide Ko Zaw argued football with my husband for two straight weeks, then found us the best mohinga in Yangon at six in the morning.",
    name: "Claire & Thomas Beaumont",
    origin: "Lyon, France",
    trip: "Golden Land Classic · Nov 2025",
    featured: true,
  },
  {
    quote:
      "They rebuilt our entire Inle leg around a monastery festival that appears in no guidebook. That is the whole review.",
    name: "Kenji Watanabe",
    origin: "Osaka, Japan",
    trip: "Shan Highlands Trek · Feb 2026",
  },
  {
    quote:
      "Honest, patient people. When a storm cancelled our flight to Heho, there was a car and a revised plan before we'd finished breakfast.",
    name: "Sarah Okafor",
    origin: "London, UK",
    trip: "The Quiet South · Jan 2026",
  },
];
---

<section class="bg-parchment text-lacquer">
  <div class="mx-auto max-w-7xl px-5 py-24 sm:px-8 lg:py-32">
    <div data-reveal class="flex flex-wrap items-end justify-between gap-6">
      <div>
        <p class="font-mono text-xs tracking-[0.24em] text-cinnabar uppercase">
          Travellers' voices
        </p>
        <h2 class="mt-5 font-display text-4xl tracking-wide sm:text-5xl">
          Word of mouth, our only shopfront
        </h2>
      </div>
      <p class="tnum font-mono text-xs tracking-[0.18em] text-lacquer/60 uppercase">
        4.9 / 5 across 312 reviews
      </p>
    </div>

    <div class="mt-14 grid gap-10 lg:grid-cols-12">
      {
        voices.map((voice, i) => (
          <figure
            data-reveal
            style={`--reveal-delay: ${i * 90}ms`}
            class={`flex flex-col ${voice.featured ? "bg-lacquer p-8 text-bone sm:p-10 lg:col-span-6" : "border-t-2 border-cinnabar pt-8 lg:col-span-3"}`}
          >
            <span aria-hidden="true" class={`font-display text-5xl leading-none select-none ${voice.featured ? "text-gold" : "text-cinnabar/50"}`}>
              “
            </span>
            <blockquote class="mt-3 font-display text-lg leading-relaxed tracking-wide sm:text-xl">
              {voice.quote}
            </blockquote>
            <figcaption class="mt-auto pt-7">
              <p class="text-sm font-semibold">{voice.name}</p>
              <p class={`mt-0.5 font-mono text-[11px] tracking-[0.16em] uppercase ${voice.featured ? "text-bone/60" : "text-lacquer/60"}`}>
                {voice.origin}
              </p>
              <p class="mt-2 font-mono text-[11px] text-cinnabar">{voice.trip}</p>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
