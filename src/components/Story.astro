---
const milestones = [
  { year: "2009", text: "One van, one phone, first guests from Osaka." },
  { year: "2013", text: "Open a year-round desk in Old Bagan." },
  { year: "2016", text: "First chartered riverboat to Mrauk U." },
  { year: "2020–22", text: "Borders closed. Every guide kept on retainer." },
  { year: "2022", text: "Reopened, quieter and somehow better." },
];
---

<section id="story" class="bg-jade-deep">
  <div class="mx-auto grid max-w-7xl gap-14 px-5 py-24 sm:px-8 lg:grid-cols-12 lg:py-32">
    <div data-reveal class="lg:col-span-5">
      <figure class="relative">
        <img
          src="/images/bagan-women.jpg"
          alt="Two women sharing tea beside their basket yokes among the ruins of Old Bagan"
          width="640"
          height="427"
          loading="lazy"
          class="aspect-[4/3] w-full border border-gold/25 object-cover"
        />
        <figcaption
          class="mt-3 font-mono text-[10px] tracking-[0.18em] text-bone/60 uppercase"
        >
          Morning round among the ruins — Old Bagan
        </figcaption>
        <span
          class="absolute -top-5 -right-5 hidden size-16 place-items-center rounded-full bg-gold text-center font-mono text-[9px] leading-tight tracking-[0.12em] text-lacquer uppercase md:grid"
          translate="no"
        >
          Since<br />2009
        </span>
      </figure>
    </div>

    <div class="lg:col-span-6 lg:col-start-7">
      <p
        data-reveal
        class="font-mono text-xs tracking-[0.24em] text-gold uppercase"
      >
        Our story
      </p>

      <blockquote
        data-reveal
        style="--reveal-delay: 90ms"
        class="mt-8 font-display text-2xl leading-snug tracking-wide text-bone sm:text-3xl"
      >
        “My father drove a taxi for the old British Council in Rangoon. He
        taught me that <span class="text-gold">a good driver is half the
        holiday.</span> We've never forgotten it.”
      </blockquote>
      <p
        data-reveal
        style="--reveal-delay: 150ms"
        class="mt-5 font-display text-lg tracking-wide text-bone/70"
        translate="no"
      >
        — Daw Khin Myo Chit, co-founder
      </p>

      <p
        data-reveal
        style="--reveal-delay: 210ms"
        class="mt-8 max-w-xl text-sm leading-relaxed text-bone/80"
      >
        Thiri Travel Co. started in 2009 with a secondhand Hiace and a
        hand-drawn map of Bagan. Seventeen years later we are still small on
        purpose: twelve staff in Yangon, nine guides across the country, and
        no call centres anywhere. Through the long border closure we paid our
        team half-wages out of savings rather than let them go — most have
        been with us since the beginning, and their names appear throughout
        this page.
      </p>

      <ol data-reveal style="--reveal-delay: 270ms" class="mt-10 space-y-0 border-t border-bone/20">
        {
          milestones.map((m) => (
            <li class="flex gap-6 border-b border-bone/20 py-3.5">
              <span class="tnum w-20 shrink-0 font-mono text-xs tracking-[0.18em] text-gold">
                {m.year}
              </span>
              <span class="text-sm text-bone/85">{m.text}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
